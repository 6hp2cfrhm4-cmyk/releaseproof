{
  "name": "@releaseproof/desktop",
  "version": "0.2.0-dev.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "description": "Local-first production-readiness verification for software projects.",
  "author": "ReleaseProof Team",
  "scripts": {
    "build": "pnpm run build:main && pnpm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "dev": "concurrently -k \"vite --port 5178\" \"wait-on http://127.0.0.1:5178 && electron .\"",
    "test": "vitest run",
    "package": "pnpm run build && electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@releaseproof/core": "workspace:*",
    "@releaseproof/detector": "workspace:*",
    "@releaseproof/reporter": "workspace:*",
    "@releaseproof/schemas": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^37.5.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.7.3",
    "vite": "^7.1.5",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.4"
  }
}
